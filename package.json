{
  "name": "vestal",
  "version": "0.1.0",
  "private": true,
  "description": "Dead-man's-switch monitoring for backup restore verification.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm install && npm run build",
    "predeploy": "npm run build:web",
    "deploy": "wrangler deploy --env \"\"",
    "db:migrate:local": "wrangler d1 migrations apply vestal --local",
    "db:migrate:remote": "wrangler d1 migrations apply vestal --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260721.1": true
  }
}
