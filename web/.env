# Cloudflare Turnstile sitekey. This is a public value (it's shipped to
# every browser as part of the page), not a secret — the real secret lives
# server-side only (TURNSTILE_SECRET_KEY, see .dev.vars / wrangler secret).
#
# This file's value is Cloudflare's own official "always passes" test
# sitekey, used for `npm run dev` and the Playwright suite so local
# development doesn't require solving a real challenge. .env.production
# overrides this with the real sitekey for the deployed build.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
